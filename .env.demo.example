# Dedicated demo service and database only. Set real HTTPS hostnames and a new secret.
NODE_ENV=production
DEMO_MODE=true
NOTIFICATION_WORKER_ENABLED=false
PORT=5000
DATABASE_URL=
API_BASE_URL=https://demo-api.example.invalid
WEB_APP_URL=https://demo-web.example.invalid
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=24h
# Console selection satisfies sender configuration; DEMO_MODE substitutes a
# fail-closed transport. No message is sent or printed to the console.
EMAIL_PROVIDER=console
EMAIL_FROM=demo@demo.tally.invalid
COOKIE_SECURE=true
COOKIE_SAME_SITE=none
LOG_LEVEL=info
