# Tally API — Local development
# Copy to .env and configure credentials.

# Application
NODE_ENV=development
PORT=5000
LOG_LEVEL=debug

# Database
POSTGRES_USER=tally
POSTGRES_PASSWORD=tally
POSTGRES_DB=tally
POSTGRES_PORT=5432
DATABASE_URL=postgresql://tally:tally@localhost:5432/tally
# Optional; defaults to DATABASE_URL.
MIGRATION_DATABASE_URL=

# URLs
API_BASE_URL=http://localhost:5000
WEB_APP_URL=http://localhost:3000

# Authentication
ACCESS_TOKEN_SECRET=replace_with_a_local_secret_of_at_least_32_bytes
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Email
# Choose one: brevo, resend, sendgrid, mailgun, gmail, smtp, console.
EMAIL_PROVIDER=brevo

# Brevo
BREVO_API_KEY=
BREVO_FROM=

# Resend
RESEND_API_KEY=
RESEND_FROM=
RESEND_WEBHOOK_SECRET=

# SendGrid
SENDGRID_API_KEY=
SENDGRID_FROM=

# Mailgun
MAILGUN_API_KEY=
MAILGUN_FROM=
EMAIL_MAILGUN_DOMAIN=

# Gmail API
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM=

# SMTP
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_SECURE=false
SMTP_FROM=

# Notifications
NOTIFICATION_WORKER_ENABLED=true

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
