POSTGRES_USER=jobtrack
POSTGRES_PASSWORD=jobtrack
POSTGRES_DB=jobtrack
# Use 5433 locally to avoid colliding with an existing PostgreSQL instance on 5432.
POSTGRES_PORT=5433

NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://jobtrack:jobtrack@localhost:5433/jobtrack
MIGRATION_DATABASE_URL=

WEB_APP_URL=http://localhost:3000

ACCESS_TOKEN_SECRET=replace_with_a_local_secret_of_at_least_32_bytes
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=no-reply@tally.local

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
LOG_LEVEL=debug
