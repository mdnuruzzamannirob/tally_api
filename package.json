{
  "name": "@tally/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --no-file-parallelism",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit tests/integration/health/app.test.ts",
    "test:integration": "cross-env REQUIRE_TEST_DATABASE=true vitest run tests/integration --no-file-parallelism",
    "test:all": "pnpm test:unit && pnpm test:integration",
    "test:smoke": "tsx scripts/release-smoke.ts",
    "contracts:generate": "tsx scripts/generate-contracts.ts",
    "contracts:validate": "pnpm contracts:validate:openapi && pnpm contracts:validate:postman",
    "contracts:validate:openapi": "tsx scripts/validate-openapi.ts",
    "contracts:validate:postman": "tsx scripts/validate-postman.ts",
    "db:setup": "prisma generate && prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "audit:identity": "tsx scripts/audit-identity-boundary.ts",
    "audit:repository": "tsx scripts/audit-repository-boundary.ts",
    "env:check": "tsx scripts/check-environment.ts",
    "env:check:production": "cross-env NODE_ENV=production tsx scripts/check-environment.ts",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose stop postgres"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.1.4",
    "pg": "^8.23.0",
    "pino": "^9.9.4",
    "pino-http": "^10.5.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@eslint/js": "^9.35.0",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.3.1",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.12",
    "cross-env": "^10.0.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.6.2",
    "prisma": "^7.9.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^4.1.12",
    "vite": "^7.3.7"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts@<8.0.0": ">=8.0.0",
      "mysql2@<3.22.0": ">=3.22.0",
      "qs@>=6.14.2 <=6.15.3": ">=6.16.0",
      "qs@>=2.2.5 <6.16.0": ">=6.16.0",
      "fast-uri@>=3.1.3 <3.1.6": ">=3.1.6",
