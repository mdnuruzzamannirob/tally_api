# Tally API — Production
# Copy to .env.production and configure credentials.

# Application
NODE_ENV=production
PORT=5000
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://tally_prod:CHANGE_ME@db.example.com:5432/tally_production
# Optional; defaults to DATABASE_URL.
MIGRATION_DATABASE_URL=

# URLs
API_BASE_URL=https://tally-api-stag.onrender.com
WEB_APP_URL=https://tallywebsite.vercel.app

# Authentication
ACCESS_TOKEN_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_SECURE=true
COOKIE_SAME_SITE=none

# Email
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=noreply@your-verified-domain.com
EMAIL_API_BASE_URL=

# Notifications
NOTIFICATION_WORKER_ENABLED=true
# Optional; only needed for delivery callbacks.
RESEND_WEBHOOK_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Other email providers (optional)
EMAIL_MAILGUN_DOMAIN=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_SECURE=false

# Optional alternative: Gmail API (HTTPS; no SMTP or custom domain needed).
# EMAIL_PROVIDER=gmail
# EMAIL_FROM=your-gmail-address@gmail.com
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
