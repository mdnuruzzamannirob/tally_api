# Tally API — Production
# Copy to .env.production and configure credentials.

# Application
NODE_ENV=production
PORT=5000
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://tally_prod:CHANGE_ME@db.example.com:5432/tally_production
# Optional; defaults to DATABASE_URL.
MIGRATION_DATABASE_URL=

# URLs
API_BASE_URL=https://tally-api-stag.onrender.com
WEB_APP_URL=https://tallywebsite.vercel.app

# Authentication
ACCESS_TOKEN_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
COOKIE_SECURE=true
COOKIE_SAME_SITE=none

# Email
# Choose one: brevo, resend, sendgrid, mailgun, gmail, smtp, console.
EMAIL_PROVIDER=brevo

# Brevo
BREVO_API_KEY=
BREVO_FROM=

# Resend
RESEND_API_KEY=
RESEND_FROM=
RESEND_WEBHOOK_SECRET=

# SendGrid
SENDGRID_API_KEY=
SENDGRID_FROM=

# Mailgun
MAILGUN_API_KEY=
MAILGUN_FROM=
EMAIL_MAILGUN_DOMAIN=

# Gmail API
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM=

# SMTP
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_SECURE=false
SMTP_FROM=

# Notifications
NOTIFICATION_WORKER_ENABLED=true

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
