# Production Environment Configuration Template for Tally API
# ============================================================
# Copy this file to .env.production and fill in with actual production values
# NEVER commit .env.production to version control
#
# Usage: cp .env.production.example .env.production && nano .env.production

# ────────────────────────────────────────────────────────
# DATABASE CONFIGURATION
# ────────────────────────────────────────────────────────
# Use a managed PostgreSQL service for production:
# - AWS RDS (recommended for AWS deployments)
# - Azure Database for PostgreSQL (for Azure)
# - DigitalOcean Managed Database (recommended for simplicity)
# - Google Cloud SQL (for GCP)
# - Self-hosted PostgreSQL (if you manage infrastructure)

POSTGRES_USER=tally_prod
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_MIN_32_CHARS
POSTGRES_DB=tally_production
POSTGRES_PORT=5432

# PostgreSQL connection string
# Format: postgresql://[user[:password]@][netloc][:port][/dbname][?param1=value1&...]
# Example: postgresql://tally:password123@db.example.com:5432/tally_prod
DATABASE_URL=postgresql://tally_prod:CHANGE_ME_PASSWORD@your-db-host.rds.amazonaws.com:5432/tally_production

# Optional: Separate migration database URL (useful for blue-green deployments)
MIGRATION_DATABASE_URL=postgresql://tally_prod:CHANGE_ME_PASSWORD@your-db-host.rds.amazonaws.com:5432/tally_production

# ────────────────────────────────────────────────────────
# NODE ENVIRONMENT
# ────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ────────────────────────────────────────────────────────
# API CONFIGURATION
# ────────────────────────────────────────────────────────
# Must use HTTPS and valid domains in production
# API_BASE_URL should match your API domain
# WEB_APP_URL should match your frontend domain

API_BASE_URL=https://api.yourdomain.com
WEB_APP_URL=https://yourdomain.com

# ────────────────────────────────────────────────────────
# JWT AUTHENTICATION
# ────────────────────────────────────────────────────────
# Generate secure secrets:
# openssl rand -base64 32
# or
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# Minimum 32 bytes (44 characters when base64 encoded)
ACCESS_TOKEN_SECRET=CHANGE_ME_GENERATE_SECURE_32_BYTE_SECRET
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# ────────────────────────────────────────────────────────
# EMAIL CONFIGURATION
# ────────────────────────────────────────────────────────
# Choose ONE email provider: mailgun, smtp, or sendgrid

# Option 1: Mailgun (Recommended - easiest setup)
EMAIL_PROVIDER=mailgun
EMAIL_API_KEY=YOUR_MAILGUN_API_KEY
EMAIL_FROM=noreply@yourdomain.com
EMAIL_MAILGUN_DOMAIN=yourdomain.com

# Option 2: SMTP (Gmail, SendGrid, or self-hosted)
# EMAIL_PROVIDER=smtp
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=your-email@gmail.com
# EMAIL_SMTP_PASSWORD=your-app-specific-password
# EMAIL_SMTP_SECURE=true
# EMAIL_FROM=noreply@yourdomain.com

# ────────────────────────────────────────────────────────
# OAUTH PROVIDERS
# ────────────────────────────────────────────────────────
# Get credentials from:
# - Google: https://console.cloud.google.com/
# - GitHub: https://github.com/settings/developers

# Google OAuth 2.0
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME_GOOGLE_CLIENT_SECRET

# GitHub OAuth 2.0
GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=CHANGE_ME_GITHUB_CLIENT_SECRET

# ────────────────────────────────────────────────────────
# SECURITY & COOKIES
# ────────────────────────────────────────────────────────
# In production:
# - COOKIE_SECURE must be true (requires HTTPS)
# - COOKIE_SAME_SITE should be "strict" or "lax"

COOKIE_SECURE=true
COOKIE_SAME_SITE=strict

# ────────────────────────────────────────────────────────
# LOGGING
# ────────────────────────────────────────────────────────
# Production levels: info, warn, error
# Never use 'debug' in production
LOG_LEVEL=info

# ────────────────────────────────────────────────────────
# OPTIONAL: CORS CONFIGURATION
# ────────────────────────────────────────────────────────
# CORS_ORIGIN=https://yourdomain.com
# CORS_CREDENTIALS=true

# ────────────────────────────────────────────────────────
# OPTIONAL: RATE LIMITING
# ────────────────────────────────────────────────────────
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=300

# ────────────────────────────────────────────────────────
# OPTIONAL: MONITORING & OBSERVABILITY
# ────────────────────────────────────────────────────────
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# DATADOG_API_KEY=your-datadog-api-key
