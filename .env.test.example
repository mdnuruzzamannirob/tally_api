NODE_ENV=test
PORT=4001

# This must point to an isolated database, never the development or production database.
TEST_DATABASE_URL=postgresql://tally:tally@localhost:5432/tally_test

# Persisted notification email worker (requires an always-on runtime)
NOTIFICATION_WORKER_ENABLED=true
# Resend webhook signing secret, separate from EMAIL_API_KEY
RESEND_WEBHOOK_SECRET=
