# Tally API — Automated tests
# Copy to .env.test and configure credentials.

# Application
NODE_ENV=test
PORT=4000
LOG_LEVEL=warn

# Database
DATABASE_URL=postgresql://tally:tally@localhost:5432/tally_test
TEST_DATABASE_URL=postgresql://tally:tally@localhost:5432/tally_test

# URLs
API_BASE_URL=http://localhost:4000
WEB_APP_URL=http://localhost:3000

# Authentication
ACCESS_TOKEN_SECRET=test-only-secret-at-least-32-bytes-long
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Email
EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@tally.test

# Notifications
NOTIFICATION_WORKER_ENABLED=false
